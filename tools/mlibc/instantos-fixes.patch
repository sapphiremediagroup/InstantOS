 		auto seek_offset = (off_t(__offset) - off_t(__io_offset));
 		if (int e = io_seek(seek_offset, SEEK_CUR, &new_offset); e) {
+			// A stream first classified file_like can have its fd replaced by a
+			// non-seekable one (e.g. a shell dup2()'ing a pipe onto a redirected,
+			// block-buffered stdout during command substitution). The fd is now a
+			// pipe: reclassify rather than fatally erroring the stream, so a plain
+			// sequential write keeps working (matches the fd's real nature).
+			if (e == ESPIPE) {
+				_type = stream_type::pipe_like;
+				return 0;
+			}
 			__status_bits |= __MLIBC_ERROR_BIT;
 			if(!mlibc::processIsExiting.load(std::memory_order_relaxed))
 				mlibc::infoLogger() << "hit io_seek() error " << e << frg::endlog;
