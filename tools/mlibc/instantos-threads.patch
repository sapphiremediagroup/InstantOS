+// What ended threads leave behind. A thread cannot free its own stack and TCB: it needs
+// them until the kernel has taken it off for good, which clears its TCB's tid (and wakes
+// who waits for that). pthread_join() waits and frees; detached threads go on a list that
+// is looked through whenever threads are made. (Without a lock: ending threads that had to
+// wait for one another piled up.) Some stacks are kept for new threads.
+FutexLock stack_lock_;
+Tcb *dead_threads_ = nullptr;
+
+struct CachedStack {
+	void *address;
+	size_t size;
+	size_t guard;
+};
+constexpr size_t max_cached_stacks_ = 16;
+CachedStack cached_stacks_[max_cached_stacks_];
+size_t cached_stack_count_ = 0;
+
+void release_stack(void *address, size_t size, size_t guard) {
+	{
+		auto g = frg::guard(&stack_lock_);
+		if (cached_stack_count_ < max_cached_stacks_) {
+			cached_stacks_[cached_stack_count_++] = {address, size, guard};
+			return;
+		}
+	}
+	mlibc::sysdep<VmUnmap>(reinterpret_cast<char *>(address) - guard, size + guard);
+}
+
+// A stack of this size from the cache, or null.
+void *take_cached_stack(size_t size, size_t guard) {
+	auto g = frg::guard(&stack_lock_);
+	for (size_t i = cached_stack_count_; i--; ) {
+		if (cached_stacks_[i].size == size && cached_stacks_[i].guard == guard) {
+			auto address = cached_stacks_[i].address;
+			cached_stacks_[i] = cached_stacks_[--cached_stack_count_];
+			return address;
+		}
+	}
+	return nullptr;
+}
+
+// The kernel is done with the thread.
+void release_thread(Tcb *tcb) {
+	if (tcb->ownsStack)
+		release_stack(tcb->stackAddr, tcb->stackSize, tcb->guardSize);
+	__rtld_freeTcb(tcb);
+}
+
+void bury_thread(Tcb *tcb) {
+	tcb->nextDead = __atomic_load_n(&dead_threads_, __ATOMIC_RELAXED);
+	while (!__atomic_compare_exchange_n(&dead_threads_, &tcb->nextDead, tcb, true,
+			__ATOMIC_RELEASE, __ATOMIC_RELAXED)) { }
