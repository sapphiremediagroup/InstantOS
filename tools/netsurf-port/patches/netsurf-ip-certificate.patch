+	ok = 0;
+	if (lwc_string_length(f->host) < sizeof(host)) {
+		memcpy(host, lwc_string_data(f->host), lwc_string_length(f->host));
+		host[lwc_string_length(f->host)] = 0;
+		ERR_set_mark();
+		ok = X509_VERIFY_PARAM_set1_ip_asc(vparam, host);
+		ERR_pop_to_mark();
+	}
+	if (!ok) {
+		ok = X509_VERIFY_PARAM_set1_host(vparam,
