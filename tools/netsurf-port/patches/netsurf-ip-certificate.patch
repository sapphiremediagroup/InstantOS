@@ -92,6 +92,7 @@
 /* Open SSL compatability for certificate handling */
 #ifdef WITH_OPENSSL
 
+#include <openssl/err.h>
 #include <openssl/ssl.h>
 #include <openssl/x509v3.h>
 
@@ -778,15 +779,28 @@
 {
 	struct curl_fetch_info *f = (struct curl_fetch_info *) parm;
 	int ok;
+	char host[64];
 	X509_VERIFY_PARAM *vparam;
 
